{
  "schema": "lima.component/1",
  "id": "text_input",
  "name": "TextInput",
  "importPath": "@lima-design/react",
  "status": "alpha",
  "props": [
    {
      "name": "aria-label",
      "type": "string",
      "required": false
    },
    {
      "name": "autoComplete",
      "type": "string",
      "required": false
    },
    {
      "name": "block",
      "type": "boolean",
      "required": false,
      "defaultValue": "false"
    },
    {
      "name": "characterLimit",
      "type": "number",
      "required": false
    },
    {
      "name": "contrast",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "deprecated": true
    },
    {
      "name": "size",
      "type": "'small' | 'medium' | 'large'",
      "required": false
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false
    },
    {
      "name": "loaderPosition",
      "type": "'auto' | 'leading' | 'trailing'",
      "required": false
    },
    {
      "name": "loaderText",
      "type": "string",
      "required": false,
      "defaultValue": "Loading"
    },
    {
      "name": "leadingVisual",
      "type": "string | React.ComponentType",
      "required": false
    },
    {
      "name": "monospace",
      "type": "boolean",
      "required": false,
      "defaultValue": "false"
    },
    {
      "name": "trailingVisual",
      "type": "string | React.ComponentType",
      "required": false
    },
    {
      "name": "trailingAction",
      "type": "React.ReactElement<HTMLProps<HTMLButtonElement>>",
      "required": false
    },
    {
      "name": "validationStatus",
      "type": "'error' | 'success'",
      "required": false
    },
    {
      "name": "variant",
      "type": "'small' | 'medium' | 'large'",
      "required": false,
      "deprecated": true
    },
    {
      "name": "width",
      "type": "string | number",
      "required": false,
      "deprecated": true
    },
    {
      "name": "maxWidth",
      "type": "string | number",
      "required": false,
      "deprecated": true
    },
    {
      "name": "minWidth",
      "type": "string | number",
      "required": false,
      "deprecated": true
    },
    {
      "name": "icon",
      "type": "React.ComponentType",
      "required": false,
      "deprecated": true
    },
    {
      "name": "ref",
      "type": "React.RefObject<HTMLInputElement>",
      "required": false
    }
  ],
  "subcomponents": [
    {
      "name": "TextInput.Action",
      "passthroughElement": "button",
      "props": [
        {
          "name": "aria-label",
          "type": "string",
          "required": false
        },
        {
          "name": "tooltipDirection",
          "type": "'n' | 'ne' | 'e' | 'se' | 's' | 'sw' | 'w' | 'nw'",
          "required": false,
          "defaultValue": "s"
        },
        {
          "name": "icon",
          "type": "React.FunctionComponent",
          "required": false
        },
        {
          "name": "variant",
          "type": "'default' | 'primary' | 'invisible' | 'danger'",
          "required": false,
          "deprecated": true
        },
        {
          "name": "ref",
          "type": "React.RefObject<HTMLButtonElement>",
          "required": false
        },
        {
          "name": "as",
          "type": "React.ElementType",
          "required": false,
          "defaultValue": "\"button\""
        }
      ]
    }
  ]
}
