{
  "schema": "lima.component/1",
  "id": "form_control",
  "name": "FormControl",
  "importPath": "@lima-design/react",
  "status": "alpha",
  "props": [
    {
      "name": "children",
      "type": "FormControl.Label | FormControl.Caption | FormControl.Validation | TextInput | Select",
      "required": true
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": "false"
    },
    {
      "name": "id",
      "type": "string",
      "required": false,
      "defaultValue": "a generated string"
    },
    {
      "name": "required",
      "type": "boolean",
      "required": false,
      "defaultValue": "false"
    },
    {
      "name": "layout",
      "type": "'vertical' | 'horizontal'",
      "required": false,
      "defaultValue": "vertical"
    },
    {
      "name": "className",
      "type": "string",
      "required": false
    },
    {
      "name": "ref",
      "type": "React.RefObject<HTMLDivElement>",
      "required": false
    }
  ],
  "subcomponents": [
    {
      "name": "FormControl.Label",
      "props": [
        {
          "name": "visuallyHidden",
          "type": "boolean",
          "required": false,
          "defaultValue": "false"
        },
        {
          "name": "as",
          "type": "'label' | 'legend' | 'span'",
          "required": false,
          "defaultValue": "'label'"
        },
        {
          "name": "requiredText",
          "type": "string",
          "required": false,
          "defaultValue": "'*'"
        },
        {
          "name": "requiredIndicator",
          "type": "boolean",
          "required": false,
          "defaultValue": "true"
        },
        {
          "name": "htmlFor",
          "type": "string",
          "required": false
        },
        {
          "name": "id",
          "type": "string",
          "required": false
        },
        {
          "name": "className",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "FormControl.Caption",
      "props": [
        {
          "name": "id",
          "type": "string",
          "required": false
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false
        }
      ]
    },
    {
      "name": "FormControl.Validation",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false
        },
        {
          "name": "variant",
          "type": "'error' | 'success'",
          "required": true
        },
        {
          "name": "id",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "FormControl.LeadingVisual",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false
        }
      ]
    }
  ]
}
