{
  "schema": "lima.component/1",
  "id": "action_menu",
  "name": "ActionMenu",
  "importPath": "@lima-design/react",
  "status": "beta",
  "props": [
    {
      "name": "children",
      "type": "React.ReactElement[]",
      "required": true
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false,
      "defaultValue": "false"
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "required": false
    },
    {
      "name": "anchorRef",
      "type": "React.RefObject<HTMLElement>",
      "required": false
    }
  ],
  "subcomponents": [
    {
      "name": "ActionMenu.Button",
      "passthroughElement": "Button",
      "props": [
        {
          "name": "children",
          "type": "React.ReactElement",
          "required": true
        }
      ]
    },
    {
      "name": "ActionMenu.Anchor",
      "props": [
        {
          "name": "children",
          "type": "React.ReactElement",
          "required": true
        },
        {
          "name": "id",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "ActionMenu.Overlay",
      "passthroughElement": "Overlay",
      "props": [
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": true
        },
        {
          "name": "align",
          "type": "start | center | end",
          "required": false,
          "defaultValue": "start"
        },
        {
          "name": "side",
          "type": "| 'inside-top' | 'inside-bottom' | 'inside-left' | 'inside-right' | 'inside-center' | 'outside-top' | 'outside-bottom' | 'outside-left' | 'outside-right'",
          "required": false,
          "defaultValue": "'outside-bottom'"
        },
        {
          "name": "onPositionChange",
          "type": "({ position }: { position: AnchorPosition }) => void",
          "required": false
        },
        {
          "name": "preventFocusOnClose",
          "type": "boolean",
          "required": false,
          "defaultValue": "false"
        },
        {
          "name": "data-test-id",
          "type": "unknown",
          "required": false
        }
      ]
    }
  ]
}
